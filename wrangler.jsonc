{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bickriaistudio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "secrets": {
    "required": ["REPLICATE_API_TOKEN"]
  }
}
